{
  "name": "amnia-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Tauri desktop app with Rust core, plain JS/Tailwind UI, and Python AI sidecar",
  "type": "module",
  "scripts": {
    "tailwind:build": "tailwindcss -i ./src/styles.css -o ./src/assets/styles.css --minify",
    "tailwind:watch": "tailwindcss -i ./src/styles.css -o ./src/assets/styles.css --watch",
    "dev": "npm run tailwind:watch",
    "build": "npm run tailwind:build",
    "tauri": "tauri",
    "tauri:dev": "npm run tailwind:build && tauri dev",
    "tauri:build": "npm run tailwind:build && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  }
}
