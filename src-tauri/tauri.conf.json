{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "amnia",
  "version": "0.1.0",
  "identifier": "com.amnia.desktop",
  "build": {
    "beforeDevCommand": "npm run tailwind:build",
    "beforeBuildCommand": "npm run tailwind:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "amnia",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "amnia local AI assistant",
    "longDescription": "amnia is a local AI desktop assistant with a Rust core, JS/Tailwind UI and Python sidecar that talks to Ollama.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "resources": [
      "../python_sidecar/**/*"
    ]
  }
}
